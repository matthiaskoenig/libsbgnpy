  shorttitle = {Systems {{Biology Graphical Notation}}},
  author = {Sorokin, Anatoly and Le Nov{\`e}re, Nicolas and Luna, Augustin and Czauderna, Tobias and Demir, Emek and Haw, Robin and Mi, Huaiyu and Moodie, Stuart and Schreiber, Falk and Vill{\'e}ger, Alice},
