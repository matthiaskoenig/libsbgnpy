<sbgn xmlns="http://sbgn.org/libsbgn/0.3">
  <map language="process description" id="notes_example">
    <glyph class="macromolecule" orientation="horizontal" id="g1">
      <notes><body xmlns="http://www.w3.org/1999/xhtml">
